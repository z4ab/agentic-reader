# M2.5 acceptance, run 2 of 2: File > Recent after a restart, and missing
# files. Run with tests/acceptance/m2.5.sh after run 1 (m2.5.steps), which
# leaves Recent saved in the scratch HOME. Between the runs the script deletes
# /tmp/agentic-reader-m2.5/doomed.pdf. missing.pdf never exists. This run is
#   scripts/shot.sh -o <out>/run2 -s tests/acceptance/m2.5-restart.steps -- \
#     env HOME=/tmp/agentic-reader-m2.5/home ./build/app/agentic-reader /tmp/agentic-reader-m2.5/missing.pdf
#
# Interface choices are the ones at the top of m2.5.steps. In addition:
#   - A command-line path that fails to open shows its message box over the
#     visible main window (parented to it), not before the window appears.
#     shot.sh waits for the "Agentic Reader" main window to become visible.
#   - Recent keeps a missing file's entry or drops it; either is fine. The
#     steps below pick only entries whose number is the same both ways.
#
# Expected Recent after run 1: 1 sample.pdf, 2 locked.pdf, 3 long.pdf,
# 4 doomed.pdf. Geometry and status bar fields as in m2.5.steps.
wait 3

# Missing file on the command line: a message box whose text contains "file
# not found" (and may name missing.pdf), over the main window. The PDF pane
# behind it holds no document (plain grey or empty), the page entry is empty
# or "/ 0".
shot cmdline-missing

key Return
wait 2

# The box is closed and the app still runs with no document. Status field 0
# does not name missing.pdf.
shot cmdline-missing-closed

key alt+f
wait 1
key r
wait 1

# After the restart File > Recent still lists run 1's files in run 1's order:
# 1 sample.pdf, 2 locked.pdf, 3 long.pdf, 4 doomed.pdf. missing.pdf is not
# listed.
shot recent-after-restart

key 3
wait 3

# Recent item 3 opened long.pdf: "Page 1 of 520" at the top of the pane, entry
# "1 / 520", status field 0 "long.pdf".
shot recent-long

key alt+f
wait 1
key r
wait 1

# long.pdf moved to the top: 1 long.pdf, 2 sample.pdf, 3 locked.pdf,
# 4 doomed.pdf.
shot recent-reordered

key 4
wait 2

# Recent item 4 is doomed.pdf, which no longer exists: a message box whose
# text contains "file not found". long.pdf is still visible behind it.
shot recent-missing

key Return
wait 2

# The box is closed. long.pdf is still shown as in recent-long, entry
# "1 / 520", status field 0 "long.pdf".
shot recent-missing-kept

key alt+f
wait 1
key r
wait 1
key 3
wait 2

# Recent item 3 is locked.pdf: the password dialog appears, as for File >
# Open. long.pdf is still behind it.
shot recent-locked-ask

type secret
key Return
wait 3

# locked.pdf is open with page 1 fully rendered ("Page One" and its text),
# entry "1 / 3", status field 0 "locked.pdf".
shot recent-locked-ok
